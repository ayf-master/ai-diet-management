# 复制为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# MySQL root 密码（同时用于 compose 内部服务连接）
DB_PASSWORD=change-me-strong-password

# Spring Boot JWT 签名密钥（至少 32 字节）
JWT_SECRET_KEY=change-me-at-least-32-bytes-secret-key

# DeepSeek API（AI 方案/周报/助手）
AI_API_KEY=sk-xxxxxxxx
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Spring 与 AI 服务之间的内部鉴权 token（两边必须一致）
INTERNAL_TOKEN=change-me-internal-token

# SMTP 邮件（忘记密码验证码；留空则开发模式直接返回验证码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
